# Copy this file to .env and fill it in. .env is git ignored, this file is public, so names only here.
# Spec section 10 says what each one is for.

# The real project. Settings are in the Supabase dashboard under Project Settings.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings, API Keys. Starts with sb_publishable_ and is safe in a browser.
SUPABASE_PUBLISHABLE_KEY=
# Project Settings, API Keys. Starts with sb_secret_ and must stay private.
SUPABASE_SECRET_KEY=
# Project Settings, Database. Used for migrations through the eu-west-1 pooler.
SUPABASE_PASSWORD=

# The second free project in eu-west-1, used for every test and the restore test.
SUPABASE_TEST_URL=https://your-test-project-ref.supabase.co
SUPABASE_TEST_SECRET_KEY=
SUPABASE_TEST_PASSWORD=
# Optional. Without it, one row level security test is skipped.
SUPABASE_TEST_PUBLISHABLE_KEY=
