{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectorZip",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::latam-trip-mcp-deploy-${ACCOUNT}-${REGION}/function-*"
    },
    {
      "Sid": "ConnectorCode",
      "Effect": "Allow",
      "Action": ["lambda:UpdateFunctionCode", "lambda:GetFunction", "lambda:GetFunctionConfiguration"],
      "Resource": "arn:aws:lambda:${REGION}:${ACCOUNT}:function:latam-trip-mcp"
    }
  ]
}
